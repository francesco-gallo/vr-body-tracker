<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Joint Visual Offsets (-1.0m to +1.0m)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEAD (Y Only) -->
            <TextView
                android:id="@+id/headLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Head Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/headYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="200"
                android:progress="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- HIP (Y Only) -->
            <TextView
                android:id="@+id/hipLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hip Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/hipYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="200"
                android:progress="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- CHEST (Y Only) -->
            <TextView
                android:id="@+id/chestLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chest Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/chestYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="200"
                android:progress="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- FEET (Symmetrical X + Y) -->
            <TextView
                android:id="@+id/feetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Feet Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/feetXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="200"
                android:progress="100" />

            <SeekBar
                android:id="@+id/feetYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="200"
                android:progress="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- KNEES (Symmetrical X + Y) -->
            <TextView
                android:id="@+id/kneesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Knees Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/kneesXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="200"
                android:progress="100" />

            <SeekBar
                android:id="@+id/kneesYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="200"
                android:progress="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- ELBOWS (Symmetrical X + Y) -->
            <TextView
                android:id="@+id/elbowsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Elbows Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/elbowsXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="200"
                android:progress="100" />

            <SeekBar
                android:id="@+id/elbowsYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:max="200"
                android:progress="100" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/resetOffsetsButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Reset Offsets" />

        <Button
            android:id="@+id/closeDialogButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Done" />
    </LinearLayout>

</LinearLayout>