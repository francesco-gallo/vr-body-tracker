<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Joint Adjustments &amp; Toggles"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GLOBAL Z OFFSET -->
            <TextView
                android:id="@+id/globalZLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Global Z Offset (Z: 0.00m)"
                android:textColor="#00FFCC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/globalZSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="8dp"
                android:background="#00FFCC" />

            <!-- 1. HEAD -->
            <CheckBox
                android:id="@+id/headCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Head Tracker"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Head Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/headYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- 2. CHEST -->
            <CheckBox
                android:id="@+id/chestCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Chest Tracker"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chestLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chest Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/chestYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- 3. ELBOWS -->
            <CheckBox
                android:id="@+id/elbowsCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Elbows Trackers"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/elbowsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elbows Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/elbowsXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="50" />

            <SeekBar
                android:id="@+id/elbowsYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- 4. HIP -->
            <CheckBox
                android:id="@+id/hipCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Hip Tracker"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hipLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hip Offset (Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/hipYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- 5. KNEES -->
            <CheckBox
                android:id="@+id/kneesCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Knees Trackers"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kneesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Knees Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/kneesXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="50" />

            <SeekBar
                android:id="@+id/kneesYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A2A2A" />

            <!-- 6. FEET -->
            <CheckBox
                android:id="@+id/feetCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Feet Trackers"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Feet Offset (Sym X: 0.00m, Y: 0.00m)"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/feetXSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="50" />

            <SeekBar
                android:id="@+id/feetYSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:max="100"
                android:progress="50" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/resetOffsetsButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Reset Offsets" />

        <Button
            android:id="@+id/closeDialogButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Done" />
    </LinearLayout>

</LinearLayout>