<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.vrproject.bodytracker.JointOverlayView
        android:id="@+id/jointOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C8000000"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/toggleUiButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Indicatore Last Build -->
            <TextView
                android:id="@+id/lastBuildText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:textSize="14sp" />

            <!-- Nascosto testo debug -->
            <TextView
                android:id="@+id/debugText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#00FFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- RIGA 1: Indirizzo IP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Indirizzo IP Destinazione (PC / Quest)"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/ipEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="es. 192.168.1.10"
                android:inputType="text"
                android:textColor="#FFFFFF" />

            <!-- RIGA 2: Porta UDP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Porta UDP VRChat (Default: 9000)"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/portEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="9000"
                android:inputType="number"
                android:textColor="#FFFFFF" />

            <!-- RIGA 3: Altezza Utente -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Altezza Utente (Metri)"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/heightEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1.70"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF" />

            <!-- RIGA 4: Target FPS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Frequenza Trasmissione (FPS Target)"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/fpsEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="60"
                android:inputType="number"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/smoothingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Smoothing Level"
                android:textColor="#FFFFFF" />

            <SeekBar
                android:id="@+id/smoothingSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/frontCameraSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Front Camera"
                android:textColor="#FFFFFF" />

            <!-- NUOVO: Informazioni Hardware Fotocamera -->
            <TextView
                android:id="@+id/cameraLevelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="Camera Level: Checking..."
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/invertCameraSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invert Camera View"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/bundleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send OSC Bundle"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/calibrateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Calibrate Neutral Pose" />

            <Button
                android:id="@+id/streamButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Start Stream" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reset Settings" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/toggleUiButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Hide UI"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>